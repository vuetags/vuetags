{
  "name": "@vuetags/root",
  "version": "1.0.0",
  "private": true,
  "description": "Simple, type safe and flexible component library that improves native HTML tags.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "ready": "vp fmt && vp lint && vp run test -r && vp run build -r",
    "dev": "vp run website#dev",
    "prepare": "vp config",
    "update": "npm run build && npm i",
    "//": "",
    "test": "clear && vitest run",
    "test:watch": "clear && vitest",
    "test:coverage": "clear && vitest run --coverage",
    "test:unit": "clear && vitest run --project unit",
    "test:browser": "clear && vitest run --project browser",
    "inputs:build": "npm --prefix ./packages/inputs/ run build",
    "inputs:test": "npm --prefix ./packages/inputs/ run test:coverage",
    "input:release": "npm --prefix ./packages/inputs/ run release",
    "docs": "vitepress dev apps/documentation",
    "docs:dev": "vitepress dev apps/documentation",
    "docs:build": "vitepress build apps/documentation",
    "docs:preview": "vitepress preview apps/documentation"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@typescript/native-preview": "^7.0.0-dev.20260318.1",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.0",
    "@vue/test-utils": "^2.4.6",
    "@vueuse/core": "^14.2.1",
    "bumpp": "^11.0.1",
    "happy-dom": "^20.8.4",
    "jsdom": "^29.0.0",
    "playwright": "^1.58.2",
    "typescript": "^5.9.3",
    "unplugin-vue": "^7.1.1",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "vue": "^3.5.30",
    "vue-tsc": "^3.2.6"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.32.1"
}
