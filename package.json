{
    "name": "@vuetags/root",
    "version": "1.0.0",
    "private": true,
    "description": "Simple, type safe and flexible component library that improves native HTML tags.",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "type": "module",
    "scripts": {
        "// ---------- Testing all packages ---------- ": "",
        "test": "clear && vitest run",
        "test:watch": "clear && vitest",
        "test:coverage": "clear && vitest run --coverage",
        "test:unit": "clear && vitest run --project unit",
        "test:browser": "clear && vitest run --project browser",
        "// ---------- Packages / Inputs ---------- ": "",
        "build": "pnpm --prefix ./packages/inputs/ run build",
        "inputs:build": "pnpm --prefix ./packages/inputs/ run build",
        "inputs:test": "pnpm --prefix ./packages/inputs/ run test:coverage",
        "input:release": "pnpm --prefix ./packages/inputs/ run release",
        "// ---------- Documentation ---------- ": "",
        "docs": "vitepress dev apps/documentation",
        "docs:dev": "vitepress dev apps/documentation",
        "docs:build": "vitepress build apps/documentation",
        "docs:preview": "vitepress preview apps/documentation",
        "// ---------- Playground ---------- ": "",
        "dev": "pnpm  --prefix ./apps/playground/ run dev"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "@typescript/native-preview": "^7.0.0-dev.20260620.1",
        "@vitejs/plugin-vue": "catalog:",
        "@vitest/browser-playwright": "catalog:",
        "@vitest/coverage-v8": "catalog:",
        "@vue/test-utils": "^2.4.11",
        "@vueuse/core": "^14.3.0",
        "bumpp": "^11.1.0",
        "happy-dom": "^20.10.6",
        "jsdom": "^29.1.1",
        "oxc-minify": "catalog:",
        "playwright": "^1.61.0",
        "typescript": "catalog:",
        "unplugin-vue": "^7.2.0",
        "vite-plus": "catalog:",
        "vitepress": "catalog:",
        "vitest": "catalog:",
        "vue": "catalog:",
        "vue-tsc": "catalog:"
    },
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "11.9.0",
            "onFail": "download"
        }
    },
    "engines": {
        "node": ">=22.12.0"
    },
    "packageManager": "pnpm@11.9.0"
}
