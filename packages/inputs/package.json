{
    "name": "@vuetags/inputs",
    "description": "Simple, type safe and flexible component library that improves native HTML input elements.",
    "version": "0.1.2",
    "author": "Michael Verschoof <michael.verschoof@gmail.com>",
    "homepage": "https://vuetags.dev",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/vuetags/vuetags.git"
    },
    "bugs": {
        "url": "https://github.com/vuetags/vuetags/issues"
    },
    "keywords": [
        "vue",
        "components",
        "tags",
        "elements",
        "html",
        "typed",
        "typescript",
        "ts",
        "type",
        "safe"
    ],
    "license": "MIT",
    "type": "module",
    "files": [
        "dist",
        "LICENSE",
        "README.md",
        "CHANGELOG.md"
    ],
    "directories": {
        "test": "test"
    },
    "types": "./dist/index.d.mts",
    "exports": {
        ".": "./dist/index.mjs",
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "vp pack",
        "dev": "vp pack --watch",
        "test": "vp test",
        "test:watch": "vp test watch",
        "test:coverage": "vp test --coverage",
        "test:unit": "vp test --project unit",
        "test:browser": "vp test --project browser",
        "release": "vp install && vp pack && npm publish --access public",
        "typecheck": "tsc --noEmit",
        "prepublishOnly": "pnpm run build"
    },
    "devDependencies": {
        "@types/node": "^25.5.0",
        "@typescript/native-preview": "^7.0.0-dev.20260315.1",
        "@vitejs/plugin-vue": "^6.0.5",
        "@vitest/coverage-v8": "^4.1.0",
        "@vue/test-utils": "^2.4.6",
        "@vueuse/core": "^14.2.1",
        "bumpp": "^11.0.0",
        "happy-dom": "^20.8.4",
        "jsdom": "^29.0.0",
        "playwright": "^1.58.2",
        "typescript": "^5.9.3",
        "unplugin-vue": "^7.1.1",
        "vite-plus": "catalog:",
        "vitest": "catalog:",
        "vue": "^3.5.30",
        "vue-tsc": "^3.2.5"
    }
}
